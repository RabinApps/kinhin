{
  "name": "kinhin-site",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/content/build.ts",
    "dev": "npm run content && next dev",
    "build": "npm run content && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/content/*.test.ts scripts/*.test.mjs src/lib/*.test.ts",
    "cf:build": "npm run content && opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:site": "scripts/build-site.sh",
    "smoke": "scripts/smoke.sh",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "E2E_VISUAL=1 playwright test --update-snapshots"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.6.0",
    "@types/hast": "^3.0.5",
    "geist": "^1.9.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "hast-util-to-string": "^3.0.1",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "^1.20.17",
    "@playwright/test": "~1.63.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
