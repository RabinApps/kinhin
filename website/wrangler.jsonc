{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinhin-site",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": ["/v*"] },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "kinhin.dev", "custom_domain": true }]
}
