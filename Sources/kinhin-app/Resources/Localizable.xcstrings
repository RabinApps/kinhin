    "Builds run in a container (Apple container or Docker); the first build downloads the video image." : {
      "comment" : "Text in VideosView",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las compilaciones se ejecutan en un contenedor (contenedor de Apple o Docker); la primera descarga la imagen de video."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビルドはコンテナ (Apple コンテナまたは Docker) 内で実行されます。初回ビルドではビデオ用イメージをダウンロードします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Builds laufen in einem Container (Apple-Container oder Docker); der erste Build lädt das Video-Image herunter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בנייה רצה בקונטיינר (Apple container או Docker); הבנייה הראשונה מורידה את אימג' הווידאו."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل عمليات البناء في حاوية (حاوية Apple أو Docker)؛ يُنزّل أول بناء صورة الفيديو."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le build vengono eseguite in un container (container Apple o Docker); la prima build scarica l'immagine video."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
