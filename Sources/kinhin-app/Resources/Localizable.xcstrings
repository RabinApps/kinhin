    "Send a message to your own webhooks (Slack, Discord, ntfy or any JSON endpoint) when the fleet raises a problem and when it clears, even with this app closed. Off by default." : {
      "comment" : "FormCard in AlertsCard"
    },
    "Send a repository, or one workflow, to a runtime. Use owner/repo for a whole repo, or owner/repo@Workflow Name for one workflow." : {
      "comment" : "Text in AddRouteSheet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل مستودعًا أو سير عمل واحدًا إلى بيئة تشغيل. استخدم owner/repo لمستودع كامل، أو owner/repo@Workflow Name لسير عمل واحد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende ein Repository oder einen Workflow an eine Runtime. Nutze owner/repo für ein ganzes Repo oder owner/repo@Workflow Name für einen Workflow."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía un repositorio, o un workflow, a un entorno de ejecución. Usa owner/repo para un repositorio completo, u owner/repo@Workflow Name para un workflow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un dépôt, ou un seul workflow, vers un runtime. Utilisez owner/repo pour un dépôt entier, ou owner/repo@Workflow Name pour un seul workflow."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלחו מאגר, או workflow אחד, אל סביבה. השתמשו ב-owner/repo למאגר שלם, או ב-owner/repo@Workflow Name ל-workflow אחד."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviare un repository, o un singolo workflow, a un runtime. Usare owner/repo per un intero repo, oppure owner/repo@Workflow Name per un singolo workflow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリ、または 1 つのワークフローをランタイムに振り分けます。リポジトリ全体は owner/repo、1 つのワークフローは owner/repo@Workflow Name を使用します。"
          }
        }
      }
    },
    "Send alerts" : {
      "comment" : "Toggle in AlertsCard"
    },
    "Send metrics, traces and logs about the fleet to your own OpenTelemetry collector, and optionally serve a local Prometheus endpoint. Off by default." : {
      "comment" : "Settings → App → Telemetry card subtitle; OpenTelemetry and Prometheus are product names",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل مقاييس وآثارًا وسجلات الأسطول إلى مُجمِّع OpenTelemetry الخاص بك، واختياريًا قدّم نقطة Prometheus محلية. معطّل افتراضيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Metriken, Traces und Logs der Flotte an deinen eigenen OpenTelemetry-Collector und stellt optional einen lokalen Prometheus-Endpunkt bereit. Standardmäßig aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía métricas, trazas y registros de la flota a tu propio colector de OpenTelemetry y, opcionalmente, sirve un endpoint local de Prometheus. Desactivado por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie les métriques, traces et journaux de la flotte à votre propre collecteur OpenTelemetry et, en option, expose un point de terminaison Prometheus local. Désactivé par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שליחת מדדים, עקבות ויומנים על הצי לאספן OpenTelemetry שלכם, ואפשר גם להפעיל נקודת קצה מקומית של Prometheus. כבוי כברירת מחדל."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia metriche, tracce e log della flotta al tuo collector OpenTelemetry e, facoltativamente, espone un endpoint Prometheus locale. Disattivato per impostazione predefinita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フリートに関するメトリクス、トレース、ログを自分の OpenTelemetry コレクターに送信し、必要に応じてローカルの Prometheus エンドポイントを公開します。初期設定ではオフです。"
          }
        }
      }
    },
