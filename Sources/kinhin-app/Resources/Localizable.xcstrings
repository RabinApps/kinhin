    "Reports one runner VM's phase, assigned job, and last error — useful before deleting a stalled VM." : {
      "comment" : "IntentDescription in DiagnoseVMIntent",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض مرحلة VM مشغّل واحد والمهمة المسندة إليه وآخر خطأ — مفيد قبل حذف VM متوقف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
