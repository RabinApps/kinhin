    "Set up something to run jobs on (step 2): a Linux runtime (Docker or Apple container), or tart for macOS jobs." : {
      "comment" : "Setup wizard blocker",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعدّ شيئًا لتشغيل المهام عليه (الخطوة 2): بيئة Linux (Docker أو حاوية Apple)، أو tart لمهام macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte etwas zum Ausführen von Jobs ein (Schritt 2): eine Linux-Runtime (Docker oder Apple-Container) oder tart für macOS-Jobs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura algo donde ejecutar los trabajos (paso 2): un entorno de ejecución de Linux (Docker o contenedor de Apple), o tart para trabajos de macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez de quoi exécuter les jobs (étape 2) : un runtime Linux (Docker ou conteneur Apple), ou tart pour les jobs macOS."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הגדירו משהו להרצת משימות (שלב 2): סביבת Linux (Docker או Apple container), או tart למשימות macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurare qualcosa su cui eseguire i job (passaggio 2): un runtime Linux (Docker o container Apple), oppure tart per i job macOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブを実行する環境をセットアップしてください (ステップ 2): Linux ランタイム (Docker または Apple コンテナ)、または macOS ジョブ用の tart。"
          }
        }
      }
    },
