{
  "sourceLanguage" : "en",
  "strings" : {
    "\nYou can also run this in Terminal: %@" : {
      "comment" : "This Mac form: hint appended to a failed install; %@ is a shell command",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTambién puedes ejecutar esto en Terminal: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTerminal でも実行できます: %@"
          }
        },
