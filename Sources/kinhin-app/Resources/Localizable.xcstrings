    "The fleet can run inside this app (in-process) or in a background LaunchAgent that survives app restarts and reboots." : {
      "comment" : "FormCard in AppSectionView",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flota puede ejecutarse dentro de esta app (en proceso) o en un LaunchAgent en segundo plano que sobrevive a los reinicios de la app y del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フリートは、このアプリ内 (インプロセス) またはバックグラウンドの LaunchAgent で実行できます。LaunchAgent はアプリの再起動や再起動後も維持されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flotte kann in dieser App (In-Process) oder in einem Hintergrund-LaunchAgent laufen, der App-Neustarts und Neustarts des Macs übersteht."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצי יכול לרוץ בתוך האפליקציה הזו (in-process) או ב-LaunchAgent ברקע ששורד הפעלות מחדש של האפליקציה ושל המחשב."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للأسطول أن يعمل داخل هذا التطبيق (in-process) أو في LaunchAgent خلفي يبقى بعد إعادة تشغيل التطبيق والجهاز."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flotta può funzionare dentro questa app (in-process) o in un LaunchAgent in background che sopravvive a riavvii dell'app e del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flotte peut s’exécuter dans cette app (intégrée) ou dans un LaunchAgent en arrière-plan qui survit aux redémarrages de l’app et du Mac."
          }
        }
      }
    },
    "The fleet didn't start at launch: %@. Start it from the menu or the Fleet tab." : {
      "comment" : "Status line when auto-start at launch fails; %@ is the reason",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La flota no se inició al abrir la app: %@. Inícialo desde el menú o la pestaña Flota."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フリートは起動時に開始されませんでした: %@。メニューまたは「フリート」タブから開始してください。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flotte wurde beim Start nicht gestartet: %@. Starte sie über das Menü oder den Tab „Flotte“."
