    "Reports one runner VM's phase, assigned job, and last error — useful before deleting a stalled VM." : {
      "comment" : "IntentDescription in DiagnoseVMIntent",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa de la fase, el trabajo asignado y el último error de una VM de runner; útil antes de eliminar una VM bloqueada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 台のランナー VM のフェーズ、割り当てられたジョブ、最後のエラーを報告します — 停止した VM を削除する前に役立ちます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldet Phase, zugewiesenen Job und letzten Fehler einer Runner-VM – nützlich, bevor eine hängende VM gelöscht wird."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מדווח על השלב, המשימה המוקצית והשגיאה האחרונה של VM אחד של runner — שימושי לפני מחיקת VM תקוע."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض مرحلة VM مشغّل واحد والمهمة المسندة إليه وآخر خطأ — مفيد قبل حذف VM متوقف."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta fase, job assegnato e ultimo errore di una VM runner — utile prima di eliminare una VM bloccata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique la phase d’une VM de runner, son job assigné et sa dernière erreur — utile avant de supprimer une VM bloquée."
          }
        }
      }
    },
    "Reports whether the runner fleet is running, how busy it is and how many jobs are queued." : {
      "comment" : "IntentDescription in FleetStatusIntent",
      "localizations" : {
        "es" : {
          "stringUnit" : {
