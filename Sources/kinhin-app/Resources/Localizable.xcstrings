          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine normale App – kein Menüleistensymbol; das Schließen des Fensters beendet kinhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una app normal: sin ítem en la barra de menús; al cerrar la ventana se sale de kinhin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une app normale — pas d’élément dans la barre des menus ; fermer la fenêtre quitte kinhin."
          }
