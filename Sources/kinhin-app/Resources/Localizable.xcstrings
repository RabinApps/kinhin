    "Ask the registry which digest it serves and store the pinned reference, so every bake uses identical bits" : {
      "comment" : ".help in BaseImagePicker",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultar al registro qué digest sirve y guardar la referencia fijada, para que cada bake use exactamente los mismos bits"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レジストリが提供するダイジェストを取得して固定した参照を保存し、すべてのビルドで同一の内容を使用します"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt die Registry, welchen Digest sie ausliefert, und speichert die angeheftete Referenz, damit jeder Bake identische Bits verwendet"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שאלו את ה-registry איזה digest הוא מגיש ושמרו את ההפניה המקובעת, כך שכל בנייה תשתמש בביטים זהים"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسأل السجل عن الـ digest الذي يقدّمه وخزّن المرجع المثبّت، ليستخدم كل bake البتات نفسها"
          }
        },
        "it" : {
          "stringUnit" : {
