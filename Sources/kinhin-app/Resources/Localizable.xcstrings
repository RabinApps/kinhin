        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densità massima se è già in esecuzione un provider Docker; amd64 tramite emulazione con limitazioni per JIT/Go/Java/.NET; kernel condiviso."
          }
        },
        "ja" : {
          "stringUnit" : {
