          }
        }
      }
    },
    "A pool name is lowercase letters, digits and inner hyphens, up to 32 characters (it becomes part of a runner label)." : {
      "comment" : "Container pool sheet validation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم المجمّع أحرف صغيرة وأرقام وشرطات داخلية، حتى 32 حرفًا (يصبح جزءًا من وسم المشغّل)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Pool-Name besteht aus Kleinbuchstaben, Ziffern und inneren Bindestrichen, höchstens 32 Zeichen (er wird Teil eines Runner-Labels)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nombre de pool lleva minúsculas, dígitos y guiones internos, hasta 32 caracteres (forma parte de una etiqueta de runner)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nom de pool se compose de minuscules, de chiffres et de tirets internes, 32 caractères au plus (il fait partie d’un label de runner)."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שם מאגר מורכב מאותיות קטנות, ספרות ומקפים פנימיים, עד 32 תווים (הוא הופך לחלק מתווית של runner)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un nome di pool è fatto di lettere minuscole, cifre e trattini interni, fino a 32 caratteri (diventa parte di un'etichetta del runner)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プール名は小文字、数字、途中のハイフンのみで、32 文字以内です（ランナーのラベルの一部になります）。"
          }
        }
      }
    },
    "A route for '%@' already exists." : {
