    "Deletes a stalled runner VM without opening the window. Pauses first so autoscale can't recreate it." : {
      "comment" : "IntentDescription in DeleteVMIntent",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف VM مشغّل متوقفًا دون فتح النافذة. يوقف مؤقتًا أولًا حتى لا يعيد التحجيم التلقائي إنشاءه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht eine hängende Runner-VM, ohne das Fenster zu öffnen. Pausiert zuerst, damit die automatische Skalierung sie nicht neu erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina una VM de runner bloqueada sin abrir la ventana. Primero pausa, para que el autoescalado no pueda volver a crearla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime une VM de runner bloquée sans ouvrir la fenêtre. Met d’abord en pause pour que l’autoscale ne puisse pas la recréer."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מוחק VM של runner תקוע בלי לפתוח את החלון. משהה קודם כדי שהקצאת הקיבולת האוטומטית לא תיצור אותו מחדש."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina una VM bloccata senza aprire la finestra. Prima mette in pausa, così l'autoscaling non può ricrearla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止したランナー VM を、ウインドウを開かずに削除します。オートスケールで再作成されないよう、先に一時停止します。"
          }
        }
      }
    },
    "Deleting %@ is in progress — check the fleet status in a moment." : {
      "comment" : "Spoken reply to a delete request; %@ is a VM id",
      "localizations" : {
        "ar" : {
