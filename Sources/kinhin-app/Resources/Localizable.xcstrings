{
  "sourceLanguage" : "en",
  "strings" : {
    "Another change is still being saved — try again in a moment." : {
      "comment" : "Settings → App → Alerts status when an edit is refused because one is being written"
    },
    "Test alert sent to %@." : {
      "comment" : "Settings → App → Alerts status after a test succeeds; %@ is the webhook's name"
    },
    "disabled" : {
      "comment" : "Routing tab pool title suffix for a switched-off pool"
    },
    "Enable %@ pool" : {
      "comment" : "Routing tab: accessibility label of a pool's on/off switch; %@ is the runtime name"
    },
    "The default pool, or a pool a route uses, stays on." : {
      "comment" : "Routing tab: tooltip on a pool switch that cannot be turned off"
    },
    "\nYou can also run this in Terminal: %@" : {
      "comment" : "This Mac form: hint appended to a failed install; %@ is a shell command",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nيمكنك أيضًا تشغيل هذا في الطرفية: %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nDu kannst dies auch im Terminal ausführen: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTambién puedes ejecutar esto en Terminal: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nVous pouvez aussi l’exécuter dans le Terminal : %@"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nאפשר גם להריץ זאת בטרמינל: %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nÈ possibile eseguirlo anche nel Terminale: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\nTerminal でも実行できます: %@"
          }
        }
      }
    },
