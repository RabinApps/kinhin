          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Flotten-Engine konnte nicht erstellt werden: %@. Die Flotte kann erst laufen, wenn dies behoben und kinhin neu geöffnet wurde."
