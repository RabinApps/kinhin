          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Committe dies als .kinhin/config.yml ins Repository und aktiviere es dann mit dem zweiten Snippet in config.yaml."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בצעו commit לזה בתור .kinhin/config.yml במאגר, ואז הפעילו אותו ב-config.yaml עם הקטע השני."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظ هذا باسم .kinhin/config.yml في المستودع، ثم فعّله في config.yaml باستخدام المقتطف الثاني."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
