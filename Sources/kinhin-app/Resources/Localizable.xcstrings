    "Send a repository, or one workflow, to a runtime. Use owner/repo for a whole repo, or owner/repo@Workflow Name for one workflow." : {
      "comment" : "Text in AddRouteSheet",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía un repositorio, o un workflow, a un entorno de ejecución. Usa owner/repo para un repositorio completo, u owner/repo@Workflow Name para un workflow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リポジトリ、または 1 つのワークフローをランタイムに振り分けます。リポジトリ全体は owner/repo、1 つのワークフローは owner/repo@Workflow Name を使用します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende ein Repository oder einen Workflow an eine Runtime. Nutze owner/repo für ein ganzes Repo oder owner/repo@Workflow Name für einen Workflow."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלחו מאגר, או workflow אחד, אל סביבה. השתמשו ב-owner/repo למאגר שלם, או ב-owner/repo@Workflow Name ל-workflow אחד."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أرسل مستودعًا أو سير عمل واحدًا إلى بيئة تشغيل. استخدم owner/repo لمستودع كامل، أو owner/repo@Workflow Name لسير عمل واحد."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inviare un repository, o un singolo workflow, a un runtime. Usare owner/repo per un intero repo, oppure owner/repo@Workflow Name per un singolo workflow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez un dépôt, ou un seul workflow, vers un runtime. Utilisez owner/repo pour un dépôt entier, ou owner/repo@Workflow Name pour un seul workflow."
          }
        }
      }
    },
