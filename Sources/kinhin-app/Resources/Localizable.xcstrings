            "value" : "Bei 0 starten VMs erst, wenn ein Job wartet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 significa que las VMs solo se inician cuando hay un trabajo en espera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 signifie que les VM ne démarrent que lorsqu’un job est en attente."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 פירושו ש-VM מופעלים רק כשמשימה ממתינה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 0 le VM si avviano solo quando un job è in attesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 にすると、ジョブが待機しているときだけ VM が起動します。"
          }
        }
      }
    },
