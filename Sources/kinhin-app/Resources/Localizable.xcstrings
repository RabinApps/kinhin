    "Highest density if a Docker provider already runs; amd64 via emulation with JIT/Go/Java/.NET caveats; shared kernel." : {
      "comment" : "Linux runtime comparison summary",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى كثافة إذا كان مزوّد Docker يعمل بالفعل؛ amd64 عبر المحاكاة مع تحفظات JIT/Go/Java/.NET؛ نواة مشتركة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchste Dichte, wenn bereits ein Docker-Anbieter läuft; amd64 per Emulation mit Einschränkungen bei JIT/Go/Java/.NET; gemeinsamer Kernel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máxima densidad si ya hay un proveedor de Docker en ejecución; amd64 mediante emulación con salvedades de JIT/Go/Java/.NET; kernel compartido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densité maximale si un fournisseur Docker tourne déjà ; amd64 par émulation avec réserves pour JIT/Go/Java/.NET ; noyau partagé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הצפיפות הגבוהה ביותר אם ספק Docker כבר פועל; amd64 בהדמיה עם הסתייגויות JIT/Go/Java/.NET; kernel משותף."
