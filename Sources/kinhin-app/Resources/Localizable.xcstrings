    "Lets a paused fleet resume on its own once the job queue is empty." : {
      "comment" : "IntentDescription in AutoResumeIntent",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que una flota en pausa se reanude sola cuando la cola de trabajos esté vacía."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューが空になったら、一時停止中のフリートが自動で再開するようにします。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lässt eine pausierte Flotte von selbst fortsetzen, sobald die Job-Warteschlange leer ist."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאפשר לצי מושהה להתחדש מעצמו כשתור המשימות ריק."
