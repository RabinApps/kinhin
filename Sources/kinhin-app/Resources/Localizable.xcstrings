    "Deleted VM %@. The fleet is paused, so it won't be recreated until you resume." : {
      "comment" : "Spoken reply to a delete request; %@ is a VM id",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ eliminada. La flota está en pausa, así que no se volverá a crear hasta que la reanudes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ を削除しました。フリートは一時停止中のため、再開するまで再作成されません。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ gelöscht. Die Flotte ist pausiert, daher wird sie erst nach dem Fortsetzen neu erstellt."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-VM‏ %@ נמחק. הצי מושהה, ולכן הוא לא ייווצר מחדש עד שתחדשו."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف VM %@. الأسطول متوقف مؤقتًا، لذا لن يُعاد إنشاؤه حتى تستأنفه."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ eliminata. La flotta è in pausa, quindi non verrà ricreata finché non viene ripresa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ supprimée. La flotte est en pause ; elle ne sera pas recréée avant la reprise."
          }
        }
      }
    },
    "Deleted VM %@. The fleet is paused; auto-resume will release it when the queue is empty." : {
      "comment" : "Spoken reply to a delete request; %@ is a VM id",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ eliminada. La flota está en pausa; la reanudación automática la liberará cuando la cola esté vacía."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ を削除しました。フリートは一時停止中です。キューが空になると自動再開で解放されます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM %@ gelöscht. Die Flotte ist pausiert; Auto-Resume gibt sie frei, sobald die Warteschlange leer ist."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-VM‏ %@ נמחק. הצי מושהה; החידוש האוטומטי ישחרר אותו כשהתור יתרוקן."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حذف VM %@. الأسطول متوقف مؤقتًا؛ سيحرّره الاستئناف التلقائي عندما يصبح الطابور فارغًا."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
