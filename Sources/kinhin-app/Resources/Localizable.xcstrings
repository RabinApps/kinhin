    "Pick how this Mac runs Linux jobs. You can change this later in the Setup tab." : {
      "comment" : "Text in LinuxRuntimeSetupSheet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر كيف يشغّل هذا الـ Mac مهام Linux. يمكنك تغيير هذا لاحقًا في تبويب الإعداد."
          }
        },
        "de" : {
          "stringUnit" : {
