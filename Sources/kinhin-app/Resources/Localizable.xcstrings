    "Booted VMs that wait for a job, so it skips the clone and boot. 0 is off." : {
      "comment" : "row in CapacityView",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VMs iniciadas que esperan un trabajo, para omitir la clonación y el arranque. 0 es desactivado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブを待機する起動済みの VM。クローンと起動を省略できます。0 でオフ。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebootete VMs, die auf einen Job warten, sodass Klonen und Booten entfallen. 0 ist aus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM מאותחלים שממתינים למשימה, כך שדילוג על השכפול והאתחול. 0 – כבוי."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VMs مشغّلة تنتظر مهمة، فتتخطى الاستنساخ والإقلاع. القيمة 0 تعني الإيقاف."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM avviate che attendono un job, così saltano clonazione e avvio. 0 = disattivato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM démarrées qui attendent un job, ce qui évite le clonage et le démarrage. 0 désactive."
          }
        }
      }
