          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إنشاء محرك الأسطول: %@. لا يمكن للأسطول أن يعمل حتى يُصلَح هذا ويُعاد فتح kinhin."
