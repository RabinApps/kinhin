    "The image every job starts from. Per-repo images with toolchains are cloned from it." : {
      "comment" : "FormCard in ToolchainsView",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de la que parte cada trabajo. Las imágenes por repositorio con toolchains se clonan a partir de ella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのジョブが開始時に使用するイメージです。ツールチェーンを含むリポジトリごとのイメージは、これからクローンされます。"
          }
        },
        "de" : {
          "stringUnit" : {
