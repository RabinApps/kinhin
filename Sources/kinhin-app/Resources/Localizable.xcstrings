    },
    "The fleet engine couldn't be created: %@. The fleet can't run until this is fixed and kinhin is reopened." : {
      "comment" : "Status line when the app can't build its fleet engine; %@ is the reason",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo crear el motor de la flota: %@. La flota no puede ejecutarse hasta que se solucione esto y se vuelva a abrir kinhin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
