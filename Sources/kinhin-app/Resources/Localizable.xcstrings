    },
    "This looks like a kinhin CI runner — restarting it cancels any job it is running." : {
      "comment" : "Confirmation body for restarting a kinhin runner container",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أنه مشغّل CI من kinhin — إعادة تشغيله تلغي أي مهمة يشغّلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nach einem kinhin-CI-Runner aus – beim Neustart wird ein laufender Job abgebrochen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece un runner de CI de kinhin: al reiniciarlo se cancela el trabajo que esté ejecutando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
