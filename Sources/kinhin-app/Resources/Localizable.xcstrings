    "  No routes — every job uses the default pool." : {
      "comment" : "StatusText in RuntimesView",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Sin rutas: todos los trabajos usan el pool predeterminado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  ルートがありません — すべてのジョブがデフォルトのプールを使用します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Keine Routen – jeder Job nutzt den Standard-Pool."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  אין ניתובים — כל משימה משתמשת ב-pool ברירת המחדל."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
