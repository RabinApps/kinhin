    "0 means VMs only start when a job is waiting." : {
      "comment" : "row in CapacityView",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 significa que las VMs solo se inician cuando hay un trabajo en espera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 にすると、ジョブが待機しているときだけ VM が起動します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei 0 starten VMs erst, wenn ein Job wartet."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0 פירושו ש-VM מופעלים רק כשמשימה ממתינה."
