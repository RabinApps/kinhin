          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベンチマークは一時的な VM とコンテナを作成し、終了時に削除します。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Benchmark erstellt temporäre VMs und Container und entfernt sie am Ende wieder."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בדיקת הביצועים יוצרת VM וקונטיינרים זמניים ומסירה אותם בסיומה."
          }
        },
        "ar" : {
          "stringUnit" : {
