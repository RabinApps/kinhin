    "  No named pools — every container job runs in the one pool container: describes." : {
      "comment" : "Routing tab, Container pools group without pools:; keep container: verbatim",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  لا توجد مجمّعات مسمّاة — كل مهمة حاوية تعمل في المجمّع الوحيد الذي يصفه container:."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Keine benannten Pools – jeder Container-Job läuft im einen Pool, den container: beschreibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Sin pools con nombre: cada trabajo de contenedor se ejecuta en el único pool que describe container:."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Aucun pool nommé : chaque tâche conteneur s’exécute dans l’unique pool décrit par container:."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  אין מאגרים בעלי שם — כל משימת קונטיינר רצה במאגר היחיד ש-container: מתאר."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Nessun pool con nome: ogni job container gira nell'unico pool descritto da container:."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  名前付きプールはありません。コンテナのジョブはすべて container: が定義する 1 つのプールで実行されます。"
          }
        }
      }
    },
    "  No routes — every job uses the default pool." : {
      "comment" : "StatusText in RuntimesView",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  لا توجد مسارات — كل مهمة تستخدم المجموعة الافتراضية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Keine Routen – jeder Job nutzt den Standard-Pool."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Sin rutas: todos los trabajos usan el pool predeterminado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Aucune route — chaque job utilise le pool par défaut."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  אין ניתובים — כל משימה משתמשת ב-pool ברירת המחדל."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Nessun instradamento — ogni job usa il pool predefinito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  ルートがありません — すべてのジョブがデフォルトのプールを使用します。"
          }
        }
      }
    },
