    "A thorough toolchains run installs every tool in the catalog on a fresh guest and takes 15 to 30 minutes or more." : {
      "comment" : "Benchmarks warning under the suite toggles",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل شامل للـ toolchains يثبّت كل أداة في الفهرس على guest جديد ويستغرق من 15 إلى 30 دقيقة أو أكثر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein gründlicher Toolchains-Lauf installiert jedes Tool des Katalogs auf einem frischen Gast und dauert 15 bis 30 Minuten oder länger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ejecución exhaustiva de toolchains instala todas las herramientas del catálogo en un invitado nuevo y tarda de 15 a 30 minutos o más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une exécution approfondie des toolchains installe chaque outil du catalogue sur un invité neuf et prend de 15 à 30 minutes, voire plus."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ריצה מקיפה של toolchains מתקינה כל כלי בקטלוג על אורח חדש ולוקחת 15 עד 30 דקות או יותר."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'esecuzione completa dei toolchain installa ogni strumento del catalogo su un guest nuovo e richiede da 15 a 30 minuti o più."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "徹底的なツールチェーン実行では、カタログ内のすべてのツールを新しいゲストにインストールするため、15〜30 分以上かかります。"
          }
        }
      }
    },
