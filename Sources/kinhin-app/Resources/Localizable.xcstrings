    "Measure boot, workload and toolchain speed on this Mac." : {
      "comment" : "Fleet tab benchmark card hint, shown before any benchmark has run",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِس سرعة الإقلاع وأحمال العمل وtoolchains على هذا الـ Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boot-, Workload- und Toolchain-Geschwindigkeit auf diesem Mac messen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide la velocidad de arranque, de carga de trabajo y de toolchains en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesurer la vitesse de démarrage, de charge et de toolchains sur ce Mac."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מדידת מהירות האתחול, עומסי העבודה והתקנת toolchains ב-Mac הזה."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura la velocità di avvio, carico di lavoro e toolchain su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac での起動、ワークロード、ツールチェーンの速度を測定します。"
          }
        }
      }
    },
    "Measure how fast runtimes boot, workloads run and toolchains install on this Mac. Temporary VMs and containers are removed afterwards." : {
      "comment" : "Subtitle of the main card in Advanced → Benchmarks",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِس سرعة إقلاع بيئات التشغيل وتنفيذ أحمال العمل وتثبيت toolchains على هذا الـ Mac. تُزال VMs والحاويات المؤقتة بعد ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misst, wie schnell Runtimes booten, Workloads laufen und Toolchains installiert werden. Temporäre VMs und Container werden anschließend entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mide la rapidez con que arrancan los entornos de ejecución, se ejecutan las cargas de trabajo y se instalan los toolchains en este Mac. Las VMs y contenedores temporales se eliminan después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesurez la vitesse de démarrage des runtimes, d’exécution des charges et d’installation des toolchains sur ce Mac. Les VM et conteneurs temporaires sont supprimés ensuite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מדידה כמה מהר סביבות מאותחלות, עומסי עבודה רצים ו-toolchains מותקנים ב-Mac הזה. VM וקונטיינרים זמניים מוסרים לאחר מכן."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misura la velocità di avvio dei runtime, di esecuzione dei carichi e di installazione dei toolchain su questo Mac. VM e container temporanei vengono rimossi al termine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Mac で、ランタイムの起動、ワークロードの実行、ツールチェーンのインストールの速さを測定します。一時的な VM とコンテナは、終了後に削除されます。"
          }
        }
      }
    },
    "Median per phase, one row per runtime." : {
      "comment" : "Subtitle of the boot comparison table in Advanced → Benchmarks",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
