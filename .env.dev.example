# Copy to .env.dev (git-ignored) and run: scripts/dev-run.sh --env-tokens
# Debug builds only. One variable per account: KINHIN_TOKEN_<ACCOUNT NAME>,
# upper-cased, non-alphanumerics as underscores (ci-bot -> KINHIN_TOKEN_CI_BOT).
KINHIN_TOKEN_GITHUB=
