# KMP keeps its generated Xcode project in iosApp/ (XcodeGen writes it; it is source, not a build output).
!examples/kmp_app/iosApp/iosApp.xcodeproj/
!examples/kmp_app/iosApp/iosApp.xcodeproj/**
