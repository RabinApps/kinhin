{
  "name": "kinhin in thirty seconds",
  "adapter": "kinhin",
  "theme": "paper",
  "format": "16:9",
  "voice": {
    "engine": "kokoro",
    "name": "af_heart"
  },
  "pronounce": {
    "kinhin": "kin-hin"
  },
  "scenes": [
    {
      "id": "intro",
      "type": "title",
      "props": {
        "title": "The mindful CI.",
        "subtitle": "kinhin",
        "mark": "ring"
      },
      "narration": "Meet kinhin. The mindful CI."
    },
    {
      "id": "app",
      "type": "device",
      "props": {
        "clip": "app",
        "frame": "macbook",
        "speed": 2.2,
        "camera": [
          {
            "at": 1.2,
            "zoom": 1.5,
            "to": [
              0.5,
              0.42
            ]
          },
          {
            "at": 5.6,
            "zoom": 1.5,
            "to": [
              0.5,
              0.76
            ]
          },
          {
            "at": 9.4,
            "zoom": 1
          }
        ],
        "focus": [
          {
            "from": 1.6,
            "to": 5.2,
            "box": [
              0.17,
              0.2,
              0.83,
              0.68
            ]
          },
          {
            "from": 6.0,
            "to": 9.0,
            "box": [
              0.17,
              0.69,
              0.83,
              0.94
            ]
          }
        ]
      },
      "cues": [
        {
          "at": 0.5,
          "text": "Jobs arrive, and kinhin scales to the queue."
        },
        {
          "at": 5.5,
          "text": "Each job gets a clean instance, deleted when it's done."
        }
      ],
      "minLength": 11,
      "transition": "push"
    },
    {
      "id": "outro",
      "type": "outro",
      "props": {
        "line": "One job. One VM. Gone when it's done.",
        "url": "kinhin.dev",
        "facts": [
          "Free",
          "Apache-2.0",
          "No telemetry",
          "In beta"
        ]
      },
      "narration": "One job. One VM. Gone when it's done."
    }
  ],
  "overrides": {},
  "transition": "dissolve"
}
